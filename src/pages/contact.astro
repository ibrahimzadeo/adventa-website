---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us - Adventa">
  <section class="hero">
    <div class="container">
      <h1>Contact Us</h1>
      <p>Ready to transform your business with AI? Let's talk.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid">
        <div class="card">
          <h3>Get in Touch</h3>
          <p>We'd love to hear about your project and discuss how we can help.</p>
          <p style="margin-top: 1rem;"><strong>Email:</strong> info@adventa.az</p>
          <p><strong>Location:</strong> Baku, Azerbaijan</p>
        </div>
        <div class="card">
          <h3>What to Expect</h3>
          <p>When you reach out, we'll schedule a discovery call to understand your needs. From there, we'll provide a tailored proposal outlining our approach, timeline, and investment.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>