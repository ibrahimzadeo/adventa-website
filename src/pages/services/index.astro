---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Our Services - Adventa">
  <section class="hero">
    <div class="container">
      <h1>Our Services</h1>
      <p>Comprehensive AI solutions designed to transform your business operations and drive growth.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid">
        <div class="card">
          <h3>AI Consulting</h3>
          <p>Strategic guidance to implement AI solutions that deliver measurable business value and competitive advantage.</p>
          <ul style="margin: 1rem 0; padding-left: 1.5rem; color: var(--text-light);">
            <li>AI Strategy Development</li>
            <li>Technology Assessment</li>
            <li>Implementation Roadmaps</li>
            <li>ROI Analysis</li>
          </ul>
          <a href="/services/ai-consulting">Learn more →</a>
        </div>
        <div class="card">
          <h3>Data Analytics</h3>
          <p>Turn raw data into actionable insights with advanced analytics, visualization, and predictive modeling.</p>
          <ul style="margin: 1rem 0; padding-left: 1.5rem; color: var(--text-light);">
            <li>Business Intelligence</li>
            <li>Predictive Analytics</li>
            <li>Data Visualization</li>
            <li>Machine Learning Models</li>
          </ul>
          <a href="/services/data-analytics">Learn more →</a>
        </div>
        <div class="card">
          <h3>Speech-to-Text</h3>
          <p>State-of-the-art speech recognition technology for transcription, voice interfaces, and accessibility solutions.</p>
          <ul style="margin: 1rem 0; padding-left: 1.5rem; color: var(--text-light);">
            <li>Real-time Transcription</li>
            <li>Voice Command Systems</li>
            <li>Meeting Transcription</li>
            <li>Accessibility Solutions</li>
          </ul>
          <a href="/services/speech-to-text">Learn more →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>