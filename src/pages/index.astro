---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Adventa - AI Solutions for Business">
  <section class="hero">
    <div class="container">
      <h1>Transform Your Business with AI</h1>
      <p>Expert AI consulting, advanced data analytics, and cutting-edge speech-to-text solutions tailored for your needs.</p>
      <a href="/services" class="btn btn-primary">Explore Our Services</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Our Core Services</h2>
      <p class="section-subtitle">Comprehensive AI solutions to drive your business forward</p>
      <div class="grid">
        <div class="card">
          <h3>AI Consulting</h3>
          <p>Strategic guidance to implement AI solutions that deliver measurable business value and competitive advantage.</p>
          <a href="/services/ai-consulting">Learn more →</a>
        </div>
        <div class="card">
          <h3>Data Analytics</h3>
          <p>Turn raw data into actionable insights with advanced analytics, visualization, and predictive modeling.</p>
          <a href="/services/data-analytics">Learn more →</a>
        </div>
        <div class="card">
          <h3>Speech-to-Text</h3>
          <p>State-of-the-art speech recognition technology for transcription, voice interfaces, and accessibility solutions.</p>
          <a href="/services/speech-to-text">Learn more →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>Why Choose Adventa?</h2>
      <p class="section-subtitle">We bring expertise, innovation, and results</p>
      <div class="grid">
        <div class="card">
          <h3>Expert Team</h3>
          <p>Our team of AI specialists brings deep technical expertise and industry experience to every project.</p>
        </div>
        <div class="card">
          <h3>Custom Solutions</h3>
          <p>We don't believe in one-size-fits-all. Every solution is tailored to your specific business needs.</p>
        </div>
        <div class="card">
          <h3>Proven Results</h3>
          <p>Our clients see measurable improvements in efficiency, decision-making, and customer engagement.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>